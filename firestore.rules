rules_version = '2';

// FreshLoop M5.2 — per-user data isolation.
// A signed-in user may read/write only their own subtree under /users/{userId}.
// Matches the data model written by the Firestore repositories:
//   /users/{uid}/runs/{autoId}        (run history)
//   /users/{uid}/favorites/{routeKey} (favourites)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
